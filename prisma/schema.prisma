generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("user")
  trade         String?
  companyName   String?
  phone         String?
  address       String?
  city          String?
  description   String?
  website       String?
  imageUrl      String?
  brandColor    String?  @default("#1E40AF")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  products      Product[]
  services      Service[]
  projects      Project[]
  proposals     VendorProposal[]
  sellerListings SellerListing[]
  notifications Notification[]
  userAgents    UserAgent[]
  subscriptions Subscription[]
  workflows     Workflow[]
  workflowActions WorkflowAction[]
  catalogs      Catalog[]
  offerComparisons OfferComparison[]

  assistantConfigs AssistantConfig[]
  assistantLogs    AssistantLog[]
  chatMessages     ChatMessage[]
  userTutorials    UserTutorial[]

  adminActions     AdminAuditLog[] @relation("AdminAuditAsAdmin")
  targetActions    AdminAuditLog[] @relation("AdminAuditAsTarget")
}

model Agent {
  id          String   @id @default(cuid())
  name        String
  type        String   // artisan, vendeur, societe, sur-mesure
  specialty   String?  // matériel, quincaillerie, carrelage, etc.
  description String?
  priceMonthly Float   @default(0)
  priceYearly  Float   @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAgents  UserAgent[]
  subscriptions Subscription[] // relation inverse
  workflows   Workflow[]       // relation inverse

  assistantConfigs AssistantConfig[]
  assistantLogs    AssistantLog[]
  chatMessages     ChatMessage[]
}

model UserAgent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  customName  String?
  status      String   @default("PENDING") // PENDING, TRIAL, ACTIVE, CANCELLED, EXPIRED
  
  startDate   DateTime @default(now())
  endDate     DateTime?
  trialEndDate DateTime?
  cancelledAt DateTime?
  graceEndAt  DateTime?

  autoRenew   Boolean  @default(false)
  stripeSubscriptionId String?
  stripeCustomerId     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, agentId, customName], name: "userId_agentId_customName")
}

model Catalog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@unique([userId, name])
}

model Product {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  category      String
  brand         String?
  purchasePrice Float
  salePrice     Float
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  tvaRate       Float    @default(20.0)
  imageUrl      String?
  catalogId     String
  catalog       Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectItems   ProjectItem[]
  vendorProposals VendorProposal[]
  sellerListings SellerListing[]
}

model Service {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  serviceCategory String   @default("prestation")
  unit            String   @default("m²")
  unitPrice       Float
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectItems    ProjectItem[]
}

model Project {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  type                  String?
  surface               Float?
  budgetEstimate        Float?
  clientBudgetMax       Float?
  status                String   @default("BROUILLON")
  clientName            String?
  clientPhone           String?
  clientEmail           String?
  clientAddress         String?
  clientFeedbackStatus  String?  @default("PENDING")
  clientFeedbackMessage String?
  clientRejectReason    String?
  clientRejectDetails   String?
  sharePublicUrl        String?
  startDate             DateTime?
  endDate               DateTime?
  paymentNotes          String?
  attachmentUrl         String?
  projectProgressMedia  String?
  portfolioMedia        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items           ProjectItem[]
  vendorProposals VendorProposal[]
  estimates       ProjectEstimate[]
  steps           ProjectStep[]
  comparisons     OfferComparison[]
  chatMessages    ChatMessage[]
  userTutorials   UserTutorial[]
}

model ProjectEstimate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material    String
  quantity    Float
  unit        String
  priceUnit   Float?
  totalPrice  Float?
  provider    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectStep {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  durationDays Int?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfferComparison {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  totalPrice  Float
  deliveryDays Int?
  products    String
  score       Float?
  isSelected  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProjectItem {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  serviceId       String?
  service         Service? @relation(fields: [serviceId], references: [id])
  quantity        Float
  unitPriceHtAtSale Float
  tvaRate         Float    @default(20.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VendorProposal {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity        Float
  unitPrice       Float
  message         String?
  status          String   @default("EN_ATTENTE")
  marketingMessage String?
  deliveryDate    DateTime?
  expirationDate  DateTime?
  feedbackReason  String?
  clientRejectReason String?
  clientRejectDetails String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SellerListing {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity      Float
  unitPrice     Float
  description   String?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AssistantConfig {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  role        String
  tone        String
  systemPrompt String
  rules       String
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    AssistantConfigVersion[]
}

model AssistantConfigVersion {
  id            String   @id @default(cuid())
  configId      String
  config        AssistantConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  version       Int
  systemPrompt  String
  role          String
  tone          String
  rules         String
  status        String
  testedAt      DateTime?
  createdBy     String
  createdAt     DateTime @default(now())
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  adminUserId   String
  adminUser     User     @relation("AdminAuditAsAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  targetUserId  String?
  targetUser    User?    @relation("AdminAuditAsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action        String
  details       String?
  metadata      String?
  createdAt     DateTime @default(now())
}

model ChatMessage {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  role        String
  content     String
  context     String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model AssistantLog {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  projectId   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action      String
  prompt      String?
  response    String?
  durationMs  Int
  tokensUsed  Int?
  error       String?
  status      String
  createdAt   DateTime @default(now())
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  type        String
  content     String?
  url         String?
  thumbnail   String?
  description String?
  keywords    String
  tags        String?
  projectType String?
  difficulty  String?
  trade       String?
  source      String?
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userTutorials UserTutorial[]
}

model UserTutorial {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId  String
  tutorial    Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  savedAt     DateTime @default(now())
  sharedAt    DateTime?
  sharedWith  String?
  createdAt   DateTime @default(now())

  @@unique([userId, tutorialId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?   @relation(fields: [agentId], references: [id])
  stripeId      String?
  plan          String
  price         Float
  status        String   @default("pending")
  startDate     DateTime @default(now())
  endDate       DateTime?
  freeAgentId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Workflow {
  id            String   @id @default(cuid())
  title         String
  description   String?
  assignedTo    String
  assignedUser  User     @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?   @relation(fields: [agentId], references: [id])
  status        String   @default("PENDING_HUMAN")
  priority      String   @default("medium")
  dueDate       DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  actions       WorkflowAction[]
}

model WorkflowAction {
  id            String   @id @default(cuid())
  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  comment       String?
  createdAt     DateTime @default(now())
}